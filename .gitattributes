# Line endings: LF everywhere (shell scripts and container builds), CRLF only for PowerShell scripts.
* text=auto eol=lf
*.ps1 text eol=crlf
*.png binary
*.webp binary
*.woff2 binary
*.ico binary
*.mp4 binary
*.webm binary
*.y4m binary

# Generated catalogue indexes: parallel features add lines, so a merge keeps both sides; npm run i18n:index regenerates them.
packages/i18n/src/messages/*/index.ts merge=union
