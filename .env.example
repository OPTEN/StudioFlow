# StudioFlow - optional overrides (.env)
#
# StudioFlow needs no .env: "docker compose up -d" starts the stack, and the first-run wizard in the Regie sets address,
# media address, certificate and embedding. The internal secrets (database password, LiveKit key pair) are generated once
# into the volume "secrets" by the init service. Create a .env (next to docker-compose.yml, never committed) only for
# one of the overrides below; every variable may stay empty or be removed, the default of docker-compose.yml then applies.
# Contract: docs/architecture/implementation-spec.md, section 10. Operations: docs/runbook.md.
#
# Put values with spaces or special characters in single quotes ('...'); nothing is substituted inside them.

# --- Images (docker-compose.release.yml) --------------------------------------------------------------------------------
#
# Only for installations from ready-made images; docker-compose.yml (build from the source) ignores both variables.
# The packages are private while the repository is: docker login ghcr.io (user name and a token with read:packages).
#
# Version of the images: latest (the newest release, default), a version such as 0.4.2, main (latest build of the main
# branch) or sha-1a2b3c4 (one commit).
STUDIOFLOW_IMAGE_TAG=

# Registry path of the images, e.g. a mirror. Default: ghcr.io/opten
STUDIOFLOW_IMAGE_REGISTRY=

# --- Ports ------------------------------------------------------------------------------------------------------------
#
# HTTPS port of the Regie, the output and the phones (tcp for HTTPS, udp for HTTP/3). Default 8443; nothing listens on
# port 80. Use 443 if nothing else on the server uses it. Change it before the first start or tell paired devices the new
# address. The firewall must allow it.
STUDIOFLOW_HTTPS_PORT=

# Ports for picture and sound (LiveKit). Default 7881/tcp and 7882/udp. Change them only if they are in use (e.g. a second
# stack on the same machine); the firewall must allow the changed ports.
STUDIOFLOW_RTC_TCP_PORT=
STUDIOFLOW_RTC_UDP_PORT=

# --- Network and security (advanced) ------------------------------------------------------------------------------------

# Subnet of the Compose network. Change it if it collides with the LAN or a VPN.
STUDIOFLOW_SUBNET=

# Proxies in front of Caddy whose X-Forwarded-For is trusted (CIDR, separated by spaces).
# Default 127.0.0.1/32 = nobody. Never enter the LAN, otherwise the IP restriction of the output can be bypassed.
STUDIOFLOW_TRUSTED_PROXIES=

# HSTS duration in seconds for every site. Without it: one year for a site with a trusted certificate (Let's Encrypt through
# DNS, your own), one hour for the local certificate (a browser must not remember "https only" for a year for a certificate
# it trusts by hand).
STUDIOFLOW_HSTS_MAX_AGE=

# DNS servers used to check the challenge record of the dns-* certificate modes. Default: '1.1.1.1 9.9.9.9'.
STUDIOFLOW_DNS_RESOLVERS=

# Request size limits in Caddy. Upload of images/videos (default 1100MiB = 1 GiB video plus multipart overhead), import of
# an exported production (default 4100MiB = 4 GiB file plus multipart overhead; the API checks its own limit,
# Transfer:MaxImportBytes, see below) and all other API calls (default 10MB). Units: MB = 10^6, MiB = 2^20.
STUDIOFLOW_MAX_UPLOAD=
STUDIOFLOW_MAX_IMPORT=
STUDIOFLOW_MAX_BODY=

# Limits of the API for media in bytes (default 26214400 = 25 MiB image, 1073741824 = 1 GiB video).
MEDIA__MAXIMAGEBYTES=
MEDIA__MAXVIDEOBYTES=

# --- Retention and checks (advanced) ------------------------------------------------------------------------------------

# Days the audit log keeps entries (default 365) and IP addresses (default 90, at most the retention of the entries).
AUDIT_RETENTION_DAYS=
AUDIT_IP_RETENTION_DAYS=

# The readiness check of the API (/health/ready) warns when the last successful backup is older than this many hours
# (default 48). The schedule, the retention and the off-site target are set in the Regie: Server settings, Backups.
BACKUP_WARN_AFTER_HOURS=

# How often a postponed backup checks whether the broadcast has ended (seconds). Default 300.
BACKUP_LIVE_POLL_SECONDS=

# --- Time limits and API limits (optional) ----------------------------------------------------------------------------
#
# Without an entry the values from the specification apply (given below for each). Meant for test stacks with short
# deadlines. Durations use the format hh:mm:ss (days: d.hh:mm:ss), everything else is a whole number; invalid values
# stop the API from starting, with a message that names the key. docker-compose.yml does not pass these variables on:
# if needed, add them under environment in the api service of docker-compose.override.yml
# (e.g. PAIRING__INVITETTL: "00:02:00").
#
# Pairing: validity of the QR code and the invite link, how long a request via /join waits, time window in which the
# poll after approval returns the credentials, window for repeated redemption with the same client ID, lead time
# for replacing the QR code before it expires.
# PAIRING__INVITETTL=00:30:00
# PAIRING__REQUESTTTL=00:10:00
# PAIRING__CREDENTIALSWINDOW=00:05:00
# PAIRING__REDEEMIDEMPOTENCYWINDOW=00:05:00
# PAIRING__PHONEINVITERENEWBEFORE=00:02:00
# Pairing: requests per IP in 10 minutes, total number of pending requests at the same time, redeem attempts per IP
# in 10 minutes.
# PAIRING__LIMITS__REQUESTSPERIPPER10MIN=10
# PAIRING__LIMITS__PENDINGTOTAL=20
# PAIRING__LIMITS__REDEEMPERIPPER10MIN=20
#
# Regie login: session lifetime (sliding), lockout after failed attempts per IP and per user name within the
# window, duration of the lockout.
# ADMIN__SESSIONLIFETIME=12:00:00
# ADMIN__LOCKOUT__MAXFAILURESPERIP=5
# ADMIN__LOCKOUT__MAXFAILURESPERUSER=20
# ADMIN__LOCKOUT__WINDOW=00:15:00
# ADMIN__LOCKOUT__DURATION=00:15:00
#
# LiveKit: validity of participant tokens and time limit for calls to LiveKit (kick, participant list).
# LIVEKIT__TOKENTTL=00:10:00
# LIVEKIT__REQUESTTIMEOUT=00:00:05
#
# Sources: a device without a report counts as disconnected after this time; after an API restart a source that was
# live within the window and is in program or preview is reported as "reconnecting" after the grace period if its
# device is not back; interval at which the last live time is stored.
# SOURCES__REPORTSTALEAFTER=00:00:06
# SOURCES__RESTARTGRACE=00:00:15
# SOURCES__RESTARTLIVEWINDOW=12:00:00
# SOURCES__LIVEMARKINTERVAL=00:01:00
#
# Output: without a fresh report the output counts as stale after this time; latency/fps at most at this interval.
# OUTPUT__STALEAFTER=00:00:06
# OUTPUT__METRICSINTERVAL=00:00:05
#
# Realtime (SignalR): server keep-alive, timeout without a sign of life from the client (at least twice the
# keep-alive), maximum wait per delivery, message buffer per connection, grace period for a last message before
# disconnecting.
# REALTIME__KEEPALIVEINTERVAL=00:00:02
# REALTIME__CLIENTTIMEOUT=00:00:05
# REALTIME__DELIVERYWAIT=00:00:02
# REALTIME__CONNECTIONQUEUELIMIT=1000
# REALTIME__DELIVERYGRACE=00:00:01

# Transfer (import of an exported production, runbook "Move a production to another server"): the largest file, the
# largest number of files in it, the largest size of everything unpacked and of the manifest (bytes), and the largest
# compression ratio of a file (a ZIP bomb unpacks to a multiple of its size; images and videos stay near 1). A file
# above a limit is refused as a whole. To accept files above 4 GiB raise STUDIOFLOW_MAX_IMPORT as well.
# TRANSFER__MAXIMPORTBYTES=4294967296
# TRANSFER__MAXENTRIES=1000
# TRANSFER__MAXUNPACKEDBYTES=8589934592
# TRANSFER__MAXMANIFESTBYTES=8388608
# TRANSFER__MAXCOMPRESSIONRATIO=100

# --- Taking over the secrets of an older installation (first start only) -------------------------------------------------
#
# An installation that was set up with the former scripts has a .env with these three values. Leave them in the .env when
# you update: the init service adopts them into the volume "secrets" on its first start (the database keeps its password)
# and ignores them from then on. A new installation leaves them empty.
POSTGRES_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
