# StudioFlow - configuration (.env)
#
# The real .env is generated by ./setup.sh (Linux/macOS) or ./setup.ps1 (Windows) with random secrets.
# It is never committed to Git and also belongs in the password vault (Keeper), because backups do not contain it.
# Contract: docs/architecture/implementation-spec.md, section 10. Operations: docs/runbook.md.
#
# Put values with spaces or special characters in single quotes ('...'); nothing is substituted inside them.
# Empty optional variables may be omitted; the default from docker-compose.yml then applies.

# --- Address and network ----------------------------------------------------------------------------------------------

# Host name of the Regie, e.g. studioflow.opten.ch (A record pointing to the LAN IP of the server).
# For tests: localhost.
STUDIOFLOW_DOMAIN=studioflow.example.ch

# LAN IPv4 of the server. LiveKit passes it on to the devices for the picture (7881/tcp, 7882/udp).
# Use 127.0.0.1 only if all browsers run on the same machine.
STUDIOFLOW_NODE_IP=192.168.1.50

# Optional: further addresses of the same site, separated by spaces (e.g. the IP for access without DNS).
# Only useful in TLS mode internal; leave empty in the dns-* modes.
STUDIOFLOW_EXTRA_HOSTS=

# Optional: certificate for browsers that connect without SNI (access by IP). Default: STUDIOFLOW_DOMAIN.
# When accessing by IP in internal mode, enter the IP here.
STUDIOFLOW_DEFAULT_SNI=

# Optional: public base URL for invite, QR and output links. Default: https://STUDIOFLOW_DOMAIN.
# Change it only if Caddy is not reachable on 443 (e.g. https://localhost:8443 in a test).
STUDIOFLOW_PUBLIC_BASE_URL=

# Optional: subnet of the Compose network. Change it if it collides with the LAN or a VPN.
STUDIOFLOW_SUBNET=172.30.0.0/24

# Optional: ports for picture and sound (LiveKit). Default 7881/tcp and 7882/udp. Change them only if they are in
# use (e.g. a second stack on the same machine); the firewall must allow the changed ports.
STUDIOFLOW_RTC_TCP_PORT=
STUDIOFLOW_RTC_UDP_PORT=

# --- Certificate (TLS) ------------------------------------------------------------------------------------------------

# internal        local CA of Caddy; devices install https://<domain>/ca.crt once (LAN test, no DNS)
# acme            Let's Encrypt via HTTP-01, only if 80/443 are reachable from the internet (VPS)
# custom          own certificate, mounted as ./certs/fullchain.pem + privkey.pem (see the override example)
# dns-cloudflare | dns-infomaniak | dns-hetzner | dns-desec | dns-route53 | dns-gandi | dns-ovh
#                 Let's Encrypt via DNS challenge: recommended for operation on Wi-Fi (subdomain on an internal IP)
STUDIOFLOW_TLS_MODE=dns-cloudflare

# E-mail for the Let's Encrypt account (acme and dns-*; notices about expiry). May be empty.
STUDIOFLOW_ACME_EMAIL=

# Credentials of the DNS provider - fill in only those of the selected mode:
#   dns-cloudflare : CF_API_TOKEN (Zone:Read + DNS:Edit)
#   dns-infomaniak : INFOMANIAK_API_TOKEN (scopes domain:read dns:read dns:write)
#   dns-hetzner    : HETZNER_API_TOKEN (Hetzner Cloud, project with the DNS zone)
#   dns-desec      : DESEC_TOKEN
#   dns-route53    : AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
#   dns-gandi      : GANDI_BEARER_TOKEN (Personal Access Token)
#   dns-ovh        : OVH_ENDPOINT (e.g. ovh-eu), OVH_APPLICATION_KEY, OVH_APPLICATION_SECRET, OVH_CONSUMER_KEY
CF_API_TOKEN=
INFOMANIAK_API_TOKEN=
HETZNER_API_TOKEN=
DESEC_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
GANDI_BEARER_TOKEN=
OVH_ENDPOINT=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Optional (dns-*): is _acme-challenge delegated by CNAME to another zone (Hostpoint, cyon ...)? Then enter the
# CNAME target here, e.g. _acme-challenge.studioflow-opten.dedyn.io. Default: _acme-challenge.STUDIOFLOW_DOMAIN.
STUDIOFLOW_DNS_CHALLENGE_DOMAIN=

# Optional (dns-*): DNS servers used to check the challenge record. Default: '1.1.1.1 9.9.9.9'.
STUDIOFLOW_DNS_RESOLVERS=

# Optional: HSTS duration in seconds. Default 31536000 (1 year); setup writes 3600 in mode internal.
STUDIOFLOW_HSTS_MAX_AGE=

# --- Security and limits ----------------------------------------------------------------------------------------------

# Optional: origins that may embed the output (/o/...) in an iframe, separated by spaces
# (e.g. 'https://proxy.example.ch https://*.example.com'). 'self' is always allowed. The Regie shows the value.
STUDIOFLOW_FRAME_ANCESTORS=

# Optional: proxies in front of Caddy whose X-Forwarded-For is trusted (CIDR, separated by spaces).
# Default 127.0.0.1/32 = nobody. Never enter the LAN, otherwise the IP restriction of the output can be bypassed.
STUDIOFLOW_TRUSTED_PROXIES=

# Optional: request size limits in Caddy. Upload of images/videos (default 1100MiB = 1 GiB video plus
# multipart overhead) and all other API calls (default 10MB). Units: MB = 10^6, MiB = 2^20.
STUDIOFLOW_MAX_UPLOAD=
STUDIOFLOW_MAX_BODY=

# Optional: limits of the API for media in bytes (default 26214400 = 25 MiB image, 1073741824 = 1 GiB video).
MEDIA__MAXIMAGEBYTES=
MEDIA__MAXVIDEOBYTES=

# --- Time limits and API limits (optional) ----------------------------------------------------------------------------
#
# Without an entry the values from the specification apply (given below for each). Meant for test stacks with short
# deadlines. Durations use the format hh:mm:ss (days: d.hh:mm:ss), everything else is a whole number; invalid values
# stop the API from starting, with a message that names the key. docker-compose.yml does not pass these variables on:
# if needed, add them under environment in the api service of docker-compose.override.yml
# (e.g. PAIRING__INVITETTL: "00:02:00").
#
# Pairing: validity of the QR code and the invite link, how long a request via /join waits, time window in which the
# poll after approval returns the credentials, window for repeated redemption with the same client ID, lead time
# for replacing the QR code before it expires.
# PAIRING__INVITETTL=00:30:00
# PAIRING__REQUESTTTL=00:10:00
# PAIRING__CREDENTIALSWINDOW=00:05:00
# PAIRING__REDEEMIDEMPOTENCYWINDOW=00:05:00
# PAIRING__PHONEINVITERENEWBEFORE=00:02:00
# Pairing: requests per IP in 10 minutes, total number of pending requests at the same time, redeem attempts per IP
# in 10 minutes.
# PAIRING__LIMITS__REQUESTSPERIPPER10MIN=10
# PAIRING__LIMITS__PENDINGTOTAL=20
# PAIRING__LIMITS__REDEEMPERIPPER10MIN=20
#
# Regie login: session lifetime (sliding), lockout after failed attempts per IP and per user name within the
# window, duration of the lockout.
# ADMIN__SESSIONLIFETIME=12:00:00
# ADMIN__LOCKOUT__MAXFAILURESPERIP=5
# ADMIN__LOCKOUT__MAXFAILURESPERUSER=20
# ADMIN__LOCKOUT__WINDOW=00:15:00
# ADMIN__LOCKOUT__DURATION=00:15:00
#
# LiveKit: validity of participant tokens and time limit for calls to LiveKit (kick, participant list).
# LIVEKIT__TOKENTTL=00:10:00
# LIVEKIT__REQUESTTIMEOUT=00:00:05
#
# Sources: a device without a report counts as disconnected after this time; after an API restart a source that was
# live within the window and is in program or preview is reported as "reconnecting" after the grace period if its
# device is not back; interval at which the last live time is stored.
# SOURCES__REPORTSTALEAFTER=00:00:06
# SOURCES__RESTARTGRACE=00:00:15
# SOURCES__RESTARTLIVEWINDOW=12:00:00
# SOURCES__LIVEMARKINTERVAL=00:01:00
#
# Output: without a fresh report the output counts as stale after this time; latency/fps at most at this interval.
# OUTPUT__STALEAFTER=00:00:06
# OUTPUT__METRICSINTERVAL=00:00:05
#
# Realtime (SignalR): server keep-alive, timeout without a sign of life from the client (at least twice the
# keep-alive), maximum wait per delivery, message buffer per connection, grace period for a last message before
# disconnecting.
# REALTIME__KEEPALIVEINTERVAL=00:00:02
# REALTIME__CLIENTTIMEOUT=00:00:05
# REALTIME__DELIVERYWAIT=00:00:02
# REALTIME__CONNECTIONQUEUELIMIT=1000
# REALTIME__DELIVERYGRACE=00:00:01

# --- Backups ----------------------------------------------------------------------------------------------------------
#
# Automatic backups run in the service "backup" of the stack (runbook section 7). They are off by default. To switch
# them on, enable the profile and set a schedule, then run: docker compose up -d --build
#   COMPOSE_PROFILES=backup
#   BACKUP_SCHEDULE='0 3 * * *'
# setup --force writes a new .env: copy these lines (and the BACKUP_* values below) from .env.backup-<time> again.
# COMPOSE_PROFILES=

# Cron expression (5 fields) in the time zone BACKUP_TIMEZONE; daily at 03:00 is a good choice. Empty = no automatic
# backups. A backup is never taken while a broadcast is live; it waits for the end of the broadcast.
BACKUP_SCHEDULE=

# Optional: time zone of the schedule and of the folder names, e.g. Europe/Zurich. Default: UTC.
BACKUP_TIMEZONE=

# Optional: how many backups are kept. The newest backup of each of the last BACKUP_KEEP_DAILY days (default 7) and of
# the last BACKUP_KEEP_WEEKLY weeks (default 4); everything else is deleted, locally and at the off-site target.
BACKUP_KEEP_DAILY=
BACKUP_KEEP_WEEKLY=

# Optional: the readiness check of the API (/health/ready) warns when the last successful backup is older than this
# many hours. Default 48.
BACKUP_WARN_AFTER_HOURS=

# Optional: how often a postponed backup checks whether the broadcast has ended (seconds). Default 300.
BACKUP_LIVE_POLL_SECONDS=

# Optional second target, an rclone remote (S3-compatible storage, SFTP and others). Without it the backups stay on
# this server and the readiness check warns. Everything that leaves the server is encrypted with age:
#   BACKUP_RCLONE_REMOTE  where to copy: <remote name>:<path>, e.g. offsite:studioflow-backups
#   BACKUP_RCLONE_CONFIG  the rclone.conf that defines the remote, as one line of base64 (secret)
#   BACKUP_AGE_RECIPIENT  public age key(s) (age1...), separated by spaces; the private key is not kept on the server
# BACKUP_OFFSITE_UNENCRYPTED=true allows an unencrypted copy if the remote encrypts by itself (an rclone crypt remote).
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_CONFIG=
BACKUP_AGE_RECIPIENT=
BACKUP_OFFSITE_UNENCRYPTED=

# --- Admin account ----------------------------------------------------------------------------------------------------

ADMIN__USERNAME=admin
# Hash (ASP.NET Identity v3) - setup generates it with the API image. Never store the plain-text password here ...
ADMIN__PASSWORDHASH=
# ... except for local development without the API image (setup --plain-password). Never on a VPS.
ADMIN__PASSWORD=

# --- Secrets (setup generates them randomly) --------------------------------------------------------------------------

# LiveKit key pair. The secret starts with a letter and is at least 32 characters long ('sk' + 40 hex).
LIVEKIT_API_KEY=studioflow
LIVEKIT_API_SECRET=

# Database password (32 characters, letters and digits only). It is set only when PostgreSQL is first initialised -
# do not change it afterwards (setup --force keeps the existing one).
POSTGRES_PASSWORD=
