# FlowStudio – Konfiguration (.env)
#
# Die echte .env erzeugt ./setup.sh (Linux/macOS) bzw. ./setup.ps1 (Windows) mit zufälligen Secrets.
# Sie kommt nie ins Git und gehört zusätzlich in den Passwort-Tresor (Keeper), weil Backups sie nicht enthalten.
# Vertrag: docs/architecture/implementation-spec.md, Abschnitt 10. Betrieb: docs/runbook.md.
#
# Werte mit Leerzeichen oder Sonderzeichen in einfache Anführungszeichen setzen ('…'); darin wird nichts ersetzt.
# Leere optionale Variablen dürfen fehlen; dann gilt der Standardwert aus docker-compose.yml.

# --- Adresse und Netz ---------------------------------------------------------------------------------------------

# Hostname der Regie, z. B. flowstudio.opten.ch (A-Record auf die LAN-IP des Servers). Für Tests: localhost.
FLOWSTUDIO_DOMAIN=flowstudio.example.ch

# LAN-IPv4 des Servers. LiveKit gibt sie den Geräten für das Bild weiter (7881/tcp, 7882/udp).
# 127.0.0.1 nur, wenn alle Browser auf demselben Rechner laufen.
FLOWSTUDIO_NODE_IP=192.168.1.50

# Optional: weitere Adressen derselben Site, mit Leerzeichen getrennt (z. B. die IP für den Zugriff ohne DNS).
# Nur im TLS-Modus internal sinnvoll; in den dns-*-Modi leer lassen.
FLOWSTUDIO_EXTRA_HOSTS=

# Optional: Zertifikat für Browser, die ohne SNI verbinden (Aufruf per IP). Standard: FLOWSTUDIO_DOMAIN.
# Beim Zugriff per IP im internen Modus hier die IP eintragen.
FLOWSTUDIO_DEFAULT_SNI=

# Optional: öffentliche Basis-URL für Einladungs-, QR- und Output-Links. Standard: https://FLOWSTUDIO_DOMAIN.
# Nur ändern, wenn Caddy nicht auf 443 erreichbar ist (z. B. https://localhost:8443 im Test).
FLOWSTUDIO_PUBLIC_BASE_URL=

# Optional: Subnetz des Compose-Netzes. Ändern, wenn es mit dem LAN oder einem VPN kollidiert.
FLOWSTUDIO_SUBNET=172.30.0.0/24

# --- Zertifikat (TLS) -----------------------------------------------------------------------------------------------

# internal        lokale CA von Caddy; Geräte installieren einmal https://<domain>/ca.crt (LAN-Test, ohne DNS)
# acme            Let's Encrypt per HTTP-01, nur wenn 80/443 aus dem Internet erreichbar sind (VPS)
# custom          eigenes Zertifikat, als ./certs/fullchain.pem + privkey.pem gemountet (siehe Override-Beispiel)
# dns-cloudflare | dns-infomaniak | dns-hetzner | dns-desec | dns-route53 | dns-gandi | dns-ovh
#                 Let's Encrypt per DNS-Challenge: empfohlen für den Betrieb im WLAN (Subdomain auf interne IP)
FLOWSTUDIO_TLS_MODE=dns-cloudflare

# E-Mail für das Let's-Encrypt-Konto (acme und dns-*; Hinweise zum Ablauf). Leer erlaubt.
FLOWSTUDIO_ACME_EMAIL=

# Zugangsdaten des DNS-Anbieters – nur die des gewählten Modus ausfüllen:
#   dns-cloudflare : CF_API_TOKEN (Zone:Read + DNS:Edit)
#   dns-infomaniak : INFOMANIAK_API_TOKEN (Scopes domain:read dns:read dns:write)
#   dns-hetzner    : HETZNER_API_TOKEN (Hetzner Cloud, Projekt mit der DNS-Zone)
#   dns-desec      : DESEC_TOKEN
#   dns-route53    : AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
#   dns-gandi      : GANDI_BEARER_TOKEN (Personal Access Token)
#   dns-ovh        : OVH_ENDPOINT (z. B. ovh-eu), OVH_APPLICATION_KEY, OVH_APPLICATION_SECRET, OVH_CONSUMER_KEY
CF_API_TOKEN=
INFOMANIAK_API_TOKEN=
HETZNER_API_TOKEN=
DESEC_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
GANDI_BEARER_TOKEN=
OVH_ENDPOINT=
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Optional (dns-*): _acme-challenge per CNAME an eine andere Zone delegiert (Hostpoint, cyon …)? Dann hier das
# CNAME-Ziel, z. B. _acme-challenge.flowstudio-opten.dedyn.io. Standard: _acme-challenge.FLOWSTUDIO_DOMAIN.
FLOWSTUDIO_DNS_CHALLENGE_DOMAIN=

# Optional (dns-*): DNS-Server für die Prüfung des Challenge-Eintrags. Standard: '1.1.1.1 9.9.9.9'.
FLOWSTUDIO_DNS_RESOLVERS=

# Optional: HSTS-Dauer in Sekunden. Standard 31536000 (1 Jahr); setup schreibt im Modus internal 3600.
FLOWSTUDIO_HSTS_MAX_AGE=

# --- Sicherheit und Grenzen -----------------------------------------------------------------------------------------

# Optional: Origins, die den Output (/o/…) per iframe einbetten dürfen, mit Leerzeichen getrennt
# (z. B. 'https://proxy.example.ch https://*.example.com'). 'self' ist immer erlaubt. Die Regie zeigt den Wert an.
FLOWSTUDIO_FRAME_ANCESTORS=

# Optional: Proxys vor Caddy, denen X-Forwarded-For geglaubt wird (CIDR, mit Leerzeichen getrennt).
# Standard 127.0.0.1/32 = niemand. Nie das LAN eintragen, sonst lässt sich die IP-Sperre des Outputs umgehen.
FLOWSTUDIO_TRUSTED_PROXIES=

# Optional: Grenzen der Request-Grösse in Caddy. Upload von Bildern/Videos (Standard 1100MiB = 1 GiB Video plus
# Multipart-Overhead) und alle übrigen API-Aufrufe (Standard 10MB). Einheiten: MB = 10^6, MiB = 2^20.
FLOWSTUDIO_MAX_UPLOAD=
FLOWSTUDIO_MAX_BODY=

# Optional: Grenzen der API für Medien in Bytes (Standard 26214400 = 25 MiB Bild, 1073741824 = 1 GiB Video).
MEDIA__MAXIMAGEBYTES=
MEDIA__MAXVIDEOBYTES=

# --- Admin-Konto ------------------------------------------------------------------------------------------------------

ADMIN__USERNAME=admin
# Hash (ASP.NET Identity v3) – setup erzeugt ihn über das API-Image. Nie das Klartext-Passwort hier ablegen …
ADMIN__PASSWORDHASH=
# … ausser für lokale Entwicklung ohne API-Image (setup --plain-password). Nie auf einer VPS.
ADMIN__PASSWORD=

# --- Secrets (setup erzeugt sie zufällig) -----------------------------------------------------------------------------

# LiveKit-Schlüsselpaar. Das Secret beginnt mit einem Buchstaben und ist mindestens 32 Zeichen lang ('sk' + 40 Hex).
LIVEKIT_API_KEY=flowstudio
LIVEKIT_API_SECRET=

# Passwort der Datenbank (32 Zeichen, nur Buchstaben und Ziffern). Wird nur bei der ersten Initialisierung von
# PostgreSQL gesetzt – danach nicht mehr ändern (setup --force übernimmt das bestehende).
POSTGRES_PASSWORD=
