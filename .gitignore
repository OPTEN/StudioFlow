# Secrets: the real .env is created by setup.sh / setup.ps1 and never committed.
.env
.env.*
!.env.example

# Node / Angular / Vite
/node_modules
/dist
/.angular/cache
/tmp
/out-tsc
/coverage
npm-debug.log
.sass-cache/

# .NET
bin/
obj/
*.user
*.suo
TestResults/
.vs/

# Playwright and test output
/tests/e2e/.output
/tests/e2e/playwright-report
/tests/e2e/test-results
/test-results
/playwright-report
__screenshots__/

# E2E harness: generated test-only environment (throwaway credentials), generated assets, results
/tests/e2e/.env.e2e
/tests/e2e/.env.e2e.*
/tests/e2e/.output/
/tests/e2e/assets/generated/
/tests/e2e/results/

# Local data and backups
/backups
/data

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.history/
.DS_Store
Thumbs.db

# Local compose overrides and own certificates (custom TLS mode)
docker-compose.override.yml
/certs

# Local git worktrees of coding agents (Claude Code); each is a checkout of a branch, never content of this one
/.claude/worktrees/
