[
  {
    "path": "packages/i18n/src/messages/de-CH/**",
    "rules": "all",
    "reason": "The German catalogue is where German text belongs."
  },
  {
    "path": "**/*.de.spec.ts",
    "rules": "all",
    "reason": "Unit tests that assert the German texts run in de-CH and are named *.de.spec.ts."
  },
  {
    "path": "packages/i18n/src/*.spec.ts",
    "rules": "all",
    "reason": "The specs of the i18n package assert both locales."
  },
  {
    "path": "tools/lib/*.spec.ts",
    "rules": "all",
    "reason": "The specs of the check use German strings as test data."
  },
  {
    "path": "docs/i18n.md",
    "rules": "all",
    "reason": "Documents the German glossary and the German style rules."
  },
  {
    "path": "docs/architecture/i18n-design.md",
    "rules": "all",
    "reason": "The i18n design quotes the German terms it maps."
  },
  {
    "path": "docs/history/**",
    "rules": "all",
    "reason": "Historical German documents, kept unchanged (D13)."
  },
  {
    "path": ".impeccable/**",
    "rules": "all",
    "reason": "Design tool state (D13)."
  },
  {
    "path": "**/generated/**",
    "rules": "all",
    "reason": "Generated from the API contracts; the texts come from the C# doc comments."
  },
  {
    "path": "apps/api/openapi/*.json",
    "rules": "all",
    "reason": "Generated OpenAPI document."
  },
  {
    "path": "**/Migrations/**",
    "rules": "all",
    "reason": "Generated database migrations."
  },
  {
    "path": "package-lock.json",
    "rules": "all",
    "reason": "Generated by npm."
  },
  {
    "path": "apps/api/src/Opten.StudioFlow.Core/Domain/Slugs.cs",
    "rules": ["H1"],
    "reason": "The slug transliteration table maps the umlauts and the sharp s on purpose."
  }
]
