{
  "name": "studioflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "StudioFlow: web-based live studio (Regie, sender PWA, output page) for webinars.",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "gen:contracts": "dotnet build apps/api/src/Opten.StudioFlow.Web -v q && openapi-typescript apps/api/openapi/studioflow.json -o packages/scene-model/src/generated/api.ts --root-types --root-types-no-schema-prefix",
    "start:studio": "ng serve studio --port 4200",
    "start:sender": "ng serve sender --port 4201",
    "start:output": "vite --config apps/output/vite.config.ts",
    "start:site": "vite --config site/vite.config.ts",
    "build:studio": "ng build studio",
    "build:sender": "ng build sender",
    "build:output": "vite build --config apps/output/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "build:video": "node video/build.mjs",
    "build:web": "npm run build:studio && npm run build:sender && npm run build:output",
    "typecheck": "tsc -p tsconfig.packages.json --noEmit",
    "typecheck:site": "tsc -p site/tsconfig.json",
    "format:check": "prettier --check .",
    "i18n:index": "node tools/i18n-index.mjs",
    "check:i18n": "node tools/i18n-index.mjs --check && node tools/check-i18n.mjs",
    "check:german": "node tools/check-german.mjs && node tools/check-german.mjs --comments",
    "check:links": "node tools/check-links.mjs",
    "check": "npm run check:i18n && npm run check:german && npm run typecheck",
    "notices": "node tools/third-party-notices.mjs",
    "brand": "node tools/build-brand.mjs",
    "check:notices": "node tools/third-party-notices.mjs --check",
    "build:prototype": "node tools/build-prototype.mjs",
    "test:unit": "vitest run",
    "test:studio": "ng test studio --watch=false",
    "test:sender": "ng test sender --watch=false",
    "test:web": "npm run test:unit && npm run test:studio && npm run test:sender",
    "test:api": "dotnet test apps/api/StudioFlow.slnx",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@microsoft/signalr": "^10.0.11",
    "livekit-client": "^2.23.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "openapi-typescript": "^7.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@angular/build": {
      "vite": "$vite"
    }
  }
}
