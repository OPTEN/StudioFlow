/* Root TypeScript configuration for the Angular apps, the output page and the shared packages. */
/* Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@studioflow/i18n/angular": ["./packages/i18n/src/angular.ts"],
      "@studioflow/i18n": ["./packages/i18n/src/index.ts"],
      "@studioflow/scene-model": ["./packages/scene-model/src/index.ts"],
      "@studioflow/scene-renderer": ["./packages/scene-renderer/src/index.ts"],
      "@studioflow/media-client": ["./packages/media-client/src/index.ts"],
      "@studioflow/media-client/device": ["./packages/media-client/src/device.ts"],
      "@studioflow/realtime-client": ["./packages/realtime-client/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    { "path": "./apps/studio/tsconfig.app.json" },
    { "path": "./apps/studio/tsconfig.spec.json" },
    { "path": "./apps/sender/tsconfig.app.json" },
    { "path": "./apps/sender/tsconfig.spec.json" },
    { "path": "./tsconfig.packages.json" }
  ]
}
