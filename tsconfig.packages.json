/* Type checking for the framework-free code: shared packages, output page and E2E tests. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "apps/output/src/**/*.ts", "apps/output/vite.config.ts", "vitest.config.ts", "tests/e2e/**/*.ts"]
}
