<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- FlowStudio only uses public packages; a single source keeps central package management deterministic (also in Docker builds). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
