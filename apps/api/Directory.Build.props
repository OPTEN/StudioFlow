<Project>
  <!-- Shared build settings for every StudioFlow .NET project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs are required for public APIs (OPTEN C# standard); missing docs on tests and generated code are not useful. -->
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1848;CA1873</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The one version of the API (and of every image): release-please sets it in the release pull request, together
         with package.json and docker-compose.release.yml. The Docker build adds the commit as SourceRevisionId, so the
         running API reports "0.1.0+1a2b3c4". -->
    <Version>0.0.0</Version> <!-- x-release-please-version -->
  </PropertyGroup>
</Project>
