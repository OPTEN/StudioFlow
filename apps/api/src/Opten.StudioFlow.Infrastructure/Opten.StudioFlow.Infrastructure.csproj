<Project Sdk="Microsoft.NET.Sdk">
  <!-- Persistence (EF Core + PostgreSQL), LiveKit server API, media storage, password hashing. -->
  <PropertyGroup>
    <RootNamespace>Opten.StudioFlow.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- LiveKit access tokens and webhook verification (HS256 JWT). -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opten.StudioFlow.Core\Opten.StudioFlow.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opten.StudioFlow.Web.Tests" />
  </ItemGroup>
</Project>
