{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FlowStudio": {
    "PublicBaseUrl": "https://localhost",
    "FrameAncestors": "'self'"
  },
  "Admin": {
    "SessionLifetime": "12:00:00",
    "Lockout": {
      "MaxFailuresPerIp": 5,
      "MaxFailuresPerUser": 20,
      "Window": "00:15:00",
      "Duration": "00:15:00"
    }
  },
  "Pairing": {
    "InviteTtl": "00:30:00",
    "RequestTtl": "00:10:00",
    "CredentialsWindow": "00:05:00",
    "RedeemIdempotencyWindow": "00:05:00",
    "PhoneInviteRenewBefore": "00:02:00",
    "Limits": {
      "RequestsPerIpPer10Min": 10,
      "PendingTotal": 20,
      "RedeemPerIpPer10Min": 20
    }
  },
  "LiveKit": {
    "InternalUrl": "http://livekit:7880",
    "TokenTtl": "00:10:00",
    "RequestTimeout": "00:00:05"
  },
  "Sources": {
    "ReportStaleAfter": "00:00:06",
    "RestartGrace": "00:00:15",
    "RestartLiveWindow": "12:00:00",
    "LiveMarkInterval": "00:01:00"
  },
  "Output": {
    "StaleAfter": "00:00:06",
    "MetricsInterval": "00:00:05"
  },
  "Realtime": {
    "KeepAliveInterval": "00:00:02",
    "ClientTimeout": "00:00:05",
    "DeliveryWait": "00:00:02",
    "ConnectionQueueLimit": 1000,
    "DeliveryGrace": "00:00:01"
  },
  "Media": {
    "Path": "/data/media",
    "MaxImageBytes": 26214400,
    "MaxVideoBytes": 1073741824
  }
