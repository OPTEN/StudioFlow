# dns-hetzner: Let's Encrypt DNS-01 via the Hetzner Cloud DNS API (the old dns.hetzner.com API is shut down).
# Module v2.0.1 supports only this inline form; the block form fails with "wrong argument count".
tls {$FLOWSTUDIO_ACME_EMAIL} {
	dns hetzner {env.HETZNER_API_TOKEN}
	propagation_delay 30s
	import /etc/caddy/snippets/dns-challenge.caddy
}
