# internal: Caddy's local CA signs the certificate. For LAN tests without a public DNS name (localhost, an IP
# address or a local name). Every device must trust the root certificate once; it is served at /ca.crt.
# The CA (incl. root.key) lives in the caddy_data volume: keep that volume, or every device has to trust a new root.
tls internal

handle /ca.crt {
	root * /data/caddy/pki/authorities/local
	# The rewrite pins the one file that is served; root.key next to it stays unreachable.
	rewrite * /root.crt
	header Content-Type application/x-x509-ca-cert
	header Content-Disposition `attachment; filename="studioflow-root-ca.crt"`
	header Cache-Control "no-cache"
	file_server
}
