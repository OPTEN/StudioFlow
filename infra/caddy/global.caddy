# Global options of every StudioFlow configuration (imported inside the global options block of the bootstrap Caddyfile
# and of the Caddyfile the API pushes).

# The admin API takes the configuration from the StudioFlow API (apps/api, CaddyAdminClient). It has no authentication and
# can read the whole configuration (DNS credentials) and replace it, so it is no network service: it listens on a unix socket
# in the volume caddy_admin, which only this container and the API mount (docker-compose.yml). Nothing else on the compose
# networks can reach it (LiveKit, PostgreSQL, the backup service), and no compose file publishes it. Caddy runs with the primary
# group 10002 and the API with the same one (compose: user), so the socket (group 10002, mode 660) is readable and writable for
# exactly those two.
admin unix//run/caddy-admin/admin.sock|0660

# Pushed configurations hold secrets (DNS credentials); Caddy must not write them to its config volume. After a restart of
# Caddy the API pushes the configuration again within seconds.
persist_config off

# Devices download the root of the local CA from /ca.crt; never touch the container's own trust store.
skip_install_trust

# Nothing listens on port 80: no redirect from HTTP to HTTPS (and no HTTP challenge: certificates come from the local CA,
# the DNS challenge or an upload).
auto_https disable_redirects

# Certificates of the local CA for names and addresses that nobody configured (a browser opens the first-run wizard by IP
# address): Caddy asks the API first, which refuses everything that is no host name or address and caps the rate.
on_demand_tls {
	ask http://api:8080/internal/tls/ask
}

# Runtime and error logs also contain request URIs (for example a failed /rtc upgrade with its token).
log default {
	output stderr
	format filter {
		wrap json
		import /etc/caddy/snippets/log-redact.caddy
	}
}
