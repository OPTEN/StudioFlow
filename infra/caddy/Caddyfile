# StudioFlow edge proxy (Caddy 2.11), bootstrap configuration. The image starts with this file; a few seconds later the
# StudioFlow API pushes the real configuration (sites, certificates, frontends, reverse proxies) through the admin API of
# Caddy and Caddy loads it without dropping a connection (docs/architecture/implementation-spec.md section 10). The API
# does the same after every change of the server settings and whenever it finds Caddy on this file again (a restart).
#
# Until then every request gets "starting", with a certificate of the local CA for whatever name or address the browser
# used. STUDIOFLOW_HTTPS_PORT is the published port (compose: default 8443); Caddy listens on the same number, so HTTP/3
# advertises the port the browser really uses. WebRTC media never passes through Caddy (LiveKit 7881/tcp, 7882/udp).
{
	import /etc/caddy/global.caddy
	https_port {$STUDIOFLOW_HTTPS_PORT}
	servers :{$STUDIOFLOW_HTTPS_PORT} {
		name bootstrap
		import /etc/caddy/servers.caddy
	}
}

import /etc/caddy/health.caddy

:{$STUDIOFLOW_HTTPS_PORT} {
	tls internal {
		on_demand
	}
	header Cache-Control "no-store"
	respond "StudioFlow is starting. The configuration arrives in a few seconds: reload this page." 503
}
